SQL> SELECT E.EMP_ID,
  2         E.E_FNAME,
  3         E.E_LNAME,
  4         E.SALARY,
  5         D.DEPT_NO,
  6         D.DNAME
  7  FROM E_DETAILS E
  8  JOIN DEPARTMENT_1 D
  9  ON E.DEPT_NO = D.DEPT_NO;

