SQL> SELECT D.DNAME, COUNT(E.EMP_ID) AS EMPLOYEE_COUNT
  2  FROM DEPARTMENT_1 D
  3  JOIN E_DETAILS E
  4  ON D.DEPT_NO = E.DEPT_NO
  5  GROUP BY D.DNAME
  6  HAVING COUNT(E.EMP_ID) > 2;

DNAME      EMPLOYEE_COUNT                                                       
---------- --------------                                                       
IT                      3                                                       

