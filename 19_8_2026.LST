SQL> autocommit OFF
autocommit OFF
linesize 80
SELECT O.ORD_ID, C.CNAME
  2  FROM ORDER1 O
  3  JOIN CUSTOMER1 C
  4  ON O.CUST_ID = C.CUST_ID;

    ORD_ID CNAME                                                                
---------- ----------                                                           
         4 ALICE                                                                
         2 CHARLIE                                                              
         3 EMMA                                                                 
         5 FRANK                                                                
         1 GRACE                                                                

SQL> SELECT C.CNAME, C.CITY, S.NAME AS SALESMAN, S.COMMISSION
  2  FROM CUSTOMER1 C
  3  JOIN SALESMAN1 S
  4  ON C.SAL_ID = S.SAL_ID
  5  WHERE S.COMMISSION BETWEEN 12 AND 14;

CNAME      CITY       SALESMAN   COMMISSION                                     
---------- ---------- ---------- ----------                                     
ALICE      NEW YORK   JOHN               12                                     
BOB        LONDON     SMITH              13                                     
DAVID      NEW YORK   JAMES              14                                     
GRACE      AHMEDABAD  JOHN               12                                     

SQL> SELECT O.ORD_ID,
  2         C.CNAME,
  3         S.COMMISSION,
  4         O.PUR_AMT * S.COMMISSION / 100 AS EARNED_COMMISSION
  5  FROM ORDER1 O
  6  JOIN CUSTOMER1 C
  7  ON O.CUST_ID = C.CUST_ID
  8  JOIN SALESMAN1 S
  9  ON C.SAL_ID = S.SAL_ID
 10  WHERE C.GRADE >= 200;

    ORD_ID CNAME      COMMISSION EARNED_COMMISSION                              
---------- ---------- ---------- -----------------                              
         1 GRACE              12                78                              
         4 ALICE              12               330                              
         3 EMMA               15             292.5                              

SQL> SELECT O.ORD_ID, C.CNAME, S.COMMISSION,
  2         O.PUR_AMT * S.COMMISSION / 100 AS EARNED_COMMISSION
  3  FROM ORDER1 O, CUSTOMER1 C, SALESMAN1 S
  4  WHERE O.CUST_ID = C.CUST_ID
  5  AND C.SAL_ID = S.SAL_ID
  6  AND C.GRADE >= 200;

    ORD_ID CNAME      COMMISSION EARNED_COMMISSION                              
---------- ---------- ---------- -----------------                              
         1 GRACE              12                78                              
         3 EMMA               15             292.5                              
         4 ALICE              12               330                              

SQL> SELECT O.ORD_ID,
  2         O.PUR_AMT,
  3         C.CNAME,
  4         C.CITY
  5  FROM ORDER1 O
  6  JOIN CUSTOMER1 C
  7  ON O.CUST_ID = C.CUST_ID
  8  WHERE O.PUR_AMT BETWEEN 500 AND 2000;

    ORD_ID    PUR_AMT CNAME      CITY                                           
